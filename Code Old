void drawDice(int16_t x, int16_t y, uint8_t value) {
  display.drawRoundRect(x, y, 30, 30, 4, SSD1306_WHITE);
  const int16_t p[6][2] = {
    {(int16_t)(x + 7),  (int16_t)(y + 7)},
    {(int16_t)(x + 15), (int16_t)(y + 7)},
    {(int16_t)(x + 23), (int16_t)(y + 7)},
    {(int16_t)(x + 7),  (int16_t)(y + 23)},
    {(int16_t)(x + 15), (int16_t)(y + 23)},
    {(int16_t)(x + 23), (int16_t)(y + 23)}
  };
  if (value == 1) display.fillCircle(x + 15, y + 15, 2, SSD1306_WHITE);
  if (value == 2) { display.fillCircle(p[0][0], p[0][1], 2, SSD1306_WHITE); display.fillCircle(p[5][0], p[5][1], 2, SSD1306_WHITE); }
