// ------------------------- PIXEL LAB / FACE --------------------------
void drawPixelLab() {
  startFrame("PIXEL LAB");
  uint32_t f = animationFrame;
  if (pixelMode == 0) {
    for (int x = 4; x < 124; x += 4) {
      int y = 30 + (int)(sin((x + f * 3) * 0.12f) * 13.0f);
      display.drawPixel(x, y, SSD1306_WHITE);
      if (x > 4) display.drawLine(x - 4, 30 + (int)(sin((x - 4 + f * 3) * 0.12f) * 13.0f), x, y, SSD1306_WHITE);
    }
  } else if (pixelMode == 1) {
    for (uint8_t i = 0; i < 18; i++) {
      int x = 6 + ((i * 19 + f * 3) % 116);
      int y = 13 + ((i * 11 + f * 2) % 35);
      display.fillRect(x, y, 2, 2, SSD1306_WHITE);
    }
  } else if (pixelMode == 2) {
    int r = 3 + (f % 12);
    display.drawCircle(64, 31, r, SSD1306_WHITE);
    display.drawCircle(64, 31, r + 7, SSD1306_WHITE);
    display.drawCircle(64, 31, r + 14, SSD1306_WHITE);
  } else {
    for (uint8_t i = 0; i < 16; i++) {
      int h = 3 + ((i * 7 + f * 5) % 25);
      display.fillRect(8 + i * 7, 49 - h, 4, h, SSD1306_WHITE);
    }
  }
  display.setCursor(5, 12);
  display.print("MODE "); display.print((unsigned)(pixelMode + 1)); display.print("/4");
  footer("TAP MODE  HOLD BACK");
  present();
}

