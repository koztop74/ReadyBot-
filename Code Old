// ------------------------- OPEN / BUTTON EVENTS -----------------------
void openSelectedMenu() {
  currentScreen = menuItems[menuIndex].screen;
  switch (currentScreen) {
    case SCR_WIFI_LIST: runWiFiScan(false); break;
    case SCR_BLE_LIST: runBLEScan(); break;
    case SCR_CHANNEL_MAP: runWiFiScan(true); break;
    case SCR_REACTION: reactionState = REACT_READY; drawReaction(); break;
    case SCR_DICE:
      diceA = 1 + (esp_random() % 6); diceB = 1 + (esp_random() % 6);
      drawDiceScreen(); break;
    case SCR_COUNTER: drawCounterScreen(); break;
    case SCR_PIXEL_LAB: lastAnimationAt = 0; drawPixelLab(); break;
    case SCR_FACE:
      nextBlinkAt = millis() + 1800 + (esp_random() % 2600); blinkUntil = 0; drawRobotFace(); break;
    case SCR_SYSTEM: systemPage = 0; drawSystemInfo(); break;
    case SCR_OLED_TEST: oledTestPattern = 0; drawOledTest(); break;
    case SCR_SETTINGS: settingsIndex = 0; drawSettings(); break;
    case SCR_ABOUT: drawAbout(); break;
    default: goHome(); break;
  }
}

void handleShortPress() {
  switch (currentScreen) {
    case SCR_HOME:
      menuIndex = (menuIndex + 1) % MENU_COUNT;
      drawHome();
      break;
    case SCR_WIFI_LIST:
      if (wifiCount == 0) runWiFiScan(false);
      else { wifiSelected = (wifiSelected + 1) % wifiCount; drawWiFiDetails(); }
      break;
    case SCR_BLE_LIST:
      if (bleCount == 0) runBLEScan();
      else { bleSelected = (bleSelected + 1) % bleCount; drawBLEDetails(); }
      break;
    case SCR_CHANNEL_MAP: runWiFiScan(true); break;
    case SCR_REACTION: handleReactionTap(); break;
    case SCR_DICE:
      diceA = 1 + (esp_random() % 6); diceB = 1 + (esp_random() % 6); drawDiceScreen(); break;
    case SCR_COUNTER:
      counterValue++;
      counterDirty = true;
      // Save each increment to make the counter survive an unexpected shutdown.
      saveCounter();
      drawCounterScreen();
      break;
    case SCR_PIXEL_LAB: pixelMode = (pixelMode + 1) % 4; drawPixelLab(); break;
    case SCR_FACE: faceMood = (faceMood + 1) % 4; drawRobotFace(); break;
    case SCR_SYSTEM: systemPage = (systemPage + 1) % 2; drawSystemInfo(); break;
    case SCR_OLED_TEST: oledTestPattern = (oledTestPattern + 1) % 4; drawOledTest(); break;
    case SCR_SETTINGS: settingsIndex = (settingsIndex + 1) % SETTINGS_COUNT; drawSettings(); break;
    case SCR_ABOUT: goHome(); break;
  }
}

void handleHoldPress(uint32_t duration) {
  if (currentScreen == SCR_HOME) {
    openSelectedMenu();
    return;
  }
  if (currentScreen == SCR_SETTINGS) {
    if (duration >= VERY_LONG_HOLD_MS) goHome();
    else applySetting();
    return;
  }
  // A very long hold is an unambiguous BACK gesture inside every tool.
  // A normal hold also goes back to keep one-button operation easy.
  goHome();
}

void pollButton() {
  bool down = (digitalRead(BUTTON_PIN) == LOW);
  uint32_t now = millis();
  if (down != buttonWasDown && now - buttonChangedAt >= DEBOUNCE_MS) {
    buttonChangedAt = now;
    buttonWasDown = down;
    if (down) {
      buttonDownAt = now;
    } else {
      uint32_t held = now - buttonDownAt;
      if (held < HOLD_MS) handleShortPress();
      else handleHoldPress(held);
    }
  }
}

// ------------------------- STARTUP / MAIN LOOP ------------------------
// Launcher-style startup: animated boot progress, a start prompt, and an
// automatic launch after a short timeout (similar to M5Launcher behaviour).
// A tap on GPIO1 skips the timeout and opens the ReadyBot interface.
void drawBootScreen(uint8_t progress, bool waiting, uint8_t secondsLeft = 0) {
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);

  // Clean monochrome launcher frame.
  display.drawRoundRect(2, 2, 124, 60, 5, SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(8, 6);
  display.print("READYBOT");
  display.setCursor(98, 6);
  display.print("v1.0");
  display.drawLine(7, 16, 120, 16, SSD1306_WHITE);

  // Small original RB emblem, built from OLED primitives (no bitmap needed).
  display.drawRoundRect(10, 22, 29, 26, 5, SSD1306_WHITE);
  display.drawLine(16, 28, 23, 28, SSD1306_WHITE);
  display.drawLine(16, 28, 16, 41, SSD1306_WHITE);
  display.drawLine(16, 34, 23, 34, SSD1306_WHITE);
  display.drawLine(23, 28, 25, 30, SSD1306_WHITE);
  display.drawLine(25, 30, 23, 34, SSD1306_WHITE);
  display.drawLine(23, 34, 26, 38, SSD1306_WHITE);
  display.drawLine(26, 38, 23, 41, SSD1306_WHITE);
  display.drawLine(23, 41, 16, 41, SSD1306_WHITE);

  display.setCursor(45, 25);
  display.print("MINI LAUNCHER");
  display.setCursor(45, 37);
  display.print(waiting ? "PRESS TO OPEN" : "BOOT CHECK...");

  // A progress bar animates during boot and counts down while waiting.
  display.drawRoundRect(8, 48, 112, 5, 2, SSD1306_WHITE);
  uint8_t fillWidth = (uint16_t)108 * progress / 100;
  if (fillWidth > 0) display.fillRect(10, 50, fillWidth, 1, SSD1306_WHITE);

  display.setCursor(8, 54);
  if (waiting) {
    display.print("AUTO START IN ");
    display.print(secondsLeft);
    display.print("s");
  } else {
    display.print("INITIALIZING...");
  }
  present();
}

void runBootSequence() {
  // Animated boot progress, deliberately short so the device remains snappy.
  for (uint8_t progress = 0; progress <= 100; progress += 5) {
    drawBootScreen(progress, false);
    delay(35);
  }

  // M5Launcher-like start screen: tap to enter immediately, otherwise auto-run.
  const uint32_t AUTO_START_MS = 5000;
  const uint32_t startedAt = millis();
  uint32_t lastDrawAt = 0;
  bool buttonPressed = false;

  while (millis() - startedAt < AUTO_START_MS) {
    uint32_t now = millis();
    uint32_t elapsed = now - startedAt;

    if (digitalRead(BUTTON_PIN) == LOW) {
      delay(30); // debounce for the boot prompt
      if (digitalRead(BUTTON_PIN) == LOW) {
        buttonPressed = true;
        while (digitalRead(BUTTON_PIN) == LOW) delay(5); // wait for release
        break;
      }
    }

    if (now - lastDrawAt >= 100) {
      uint8_t remaining = (uint8_t)((AUTO_START_MS - elapsed + 999) / 1000);
      uint8_t progress = (uint8_t)(100 - ((uint64_t)elapsed * 100 / AUTO_START_MS));
      drawBootScreen(progress, true, remaining);
      lastDrawAt = now;
    }
    delay(3);
  }

  (void)buttonPressed; // either a tap or timeout continues into ReadyBot
  display.clearDisplay();
  display.drawRoundRect(7, 11, 114, 42, 5, SSD1306_WHITE);
  centeredText("READYBOT", 20, 2);
  centeredText("STARTING...", 40, 1);
  present();
  delay(280);

  // Do not let a boot-screen press leak into the normal button state machine.
  buttonWasDown = false;
  buttonEventPending = false;
  buttonChangedAt = millis();
}

void setup() {
  pinMode(BUTTON_PIN, INPUT_PULLUP);
  Serial.begin(115200);
  Wire.begin(OLED_SDA, OLED_SCL);

  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDRESS)) {
    // The display is needed for the interface; provide a serial diagnostic.
    Serial.println("READYBOT: SSD1306 not found at I2C 0x3C. Check SDA=9, SCL=10, VCC, GND.");
    while (true) delay(1000);
  }

  prefs.begin("readybot", false);
  counterValue = prefs.getUInt("counter", 0);
  invertMode = prefs.getBool("invert", false);
  rotateMode = prefs.getBool("rotate", false);
  applyDisplaySettings();

  // Radio modules are deliberately off at boot.
  WiFi.mode(WIFI_OFF);
  randomSeed(esp_random());
  runBootSequence();
  currentScreen = SCR_HOME;
  drawHome();
  Serial.println("READYBOT ready. Button GPIO1: tap=next/action, hold=select/back.");
}

void loop() {
  pollButton();
  uint32_t now = millis();

  if (currentScreen == SCR_REACTION && reactionState == REACT_WAITING && now - reactionStartedAt >= reactionDelay) {
    reactionState = REACT_GO;
    drawReaction();
  }

  if (currentScreen == SCR_PIXEL_LAB && now - lastAnimationAt >= 90) {
    lastAnimationAt = now;
    animationFrame++;
    drawPixelLab();
  }

  if (currentScreen == SCR_FACE) {
    if (now >= nextBlinkAt && now >= blinkUntil) {
      blinkUntil = now + 130;
      nextBlinkAt = now + 1900 + (esp_random() % 3000);
      drawRobotFace();
    } else if (blinkUntil && now >= blinkUntil) {
      blinkUntil = 0;
      drawRobotFace();
    }
  }

  delay(4);
}
