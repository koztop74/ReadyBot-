void drawSettings() {
  startFrame("SETTINGS", String(settingsIndex + 1) + "/3");
  for (uint8_t i = 0; i < SETTINGS_COUNT; i++) {
    int y = 15 + i * 12;
    if (i == settingsIndex) {
      display.fillRoundRect(5, y - 1, 118, 11, 2, SSD1306_WHITE);
      display.setTextColor(SSD1306_BLACK);
