      display.setTextColor(SSD1306_WHITE);
    }
    display.setCursor(9, y + 1);
    display.print(settingNames[i]);
    display.setCursor(101, y + 1);
    if (i == 0) display.print(invertMode ? "ON" : "OFF");
    if (i == 1) display.print(rotateMode ? "ON" : "OFF");
    if (i == 2) display.print("GO");
  }
  display.setTextColor(SSD1306_WHITE);
  footer("TAP MOVE  HOLD APPLY");
  present();
