// ------------------------- SMALL HELPERS ----------------------------
void centeredText(const String &text, int16_t y, uint8_t size = 1) {
  // Use the built-in 5x7 font metrics (6 pixels per character including spacing).
  // This deliberately avoids getTextBounds(), so it also works with older or
  // vendor-modified Adafruit_GFX/SSD1306 library installations.
  display.setTextSize(size);
  int32_t textWidth = (int32_t)text.length() * 6L * size;
  int16_t x = (int16_t)((SCREEN_WIDTH - textWidth) / 2);
  if (x < 0) x = 0;
  display.setCursor(x, y);
  display.print(text);
}

String clipped(const String &value, uint8_t maxChars) {
  if (value.length() <= maxChars) return value;
  if (maxChars < 4) return value.substring(0, maxChars);
  return value.substring(0, maxChars - 3) + "...";
}

void startFrame(const String &title, const String &right = "") {
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(4, 1);
  display.print(clipped(title, 15));
  if (right.length()) {
    int x = 124 - (int)right.length() * 6;
    if (x < 82) x = 82;
    display.setCursor(x, 1);
    display.print(right);
  }
  display.drawLine(3, 10, 124, 10, SSD1306_WHITE);
}

void footer(const char *text = "TAP NEXT  HOLD BACK") {
  display.drawLine(3, 53, 124, 53, SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(4, 56);
  display.print(text);
}

void present() {
  display.display();
}

void showMessage(const String &title, const String &line1, const String &line2 = "") {
  startFrame(title);
  centeredText(line1, 22);
  if (line2.length()) centeredText(line2, 34);
  footer("PLEASE WAIT...");
  present();
}

