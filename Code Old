// ------------------------- WI-FI TOOLS -------------------------------
void turnWiFiOff() {
  WiFi.disconnect(false, false);
  WiFi.scanDelete();
  WiFi.mode(WIFI_OFF);
}

void runWiFiScan(bool forChannelMap) {
  // Do not leave Bluetooth active while changing radio mode.
  showMessage(forChannelMap ? "CHANNEL MAP" : "WIFI SCAN", "Scanning 2.4 GHz...", "Passive discovery");
  turnWiFiOff();
  delay(80);
  WiFi.mode(WIFI_STA);
  WiFi.disconnect(false, false);
  delay(80);

  int n = WiFi.scanNetworks(false, true, true, 250);
  wifiCount = 0;
  wifiTotalFound = 0;
  memset(channelCounts, 0, sizeof(channelCounts));

  if (n > 0) {
    wifiTotalFound = (uint16_t)n;
    for (int i = 0; i < n; i++) {
      int ch = WiFi.channel(i);
      if (ch >= 1 && ch <= 13 && channelCounts[ch] < 255) channelCounts[ch]++;
      if (wifiCount < MAX_WIFI) {
        WiFi.SSID(i).toCharArray(wifiNames[wifiCount], sizeof(wifiNames[wifiCount]));
        wifiRssi[wifiCount] = WiFi.RSSI(i);
        wifiChannel[wifiCount] = (uint8_t)ch;
        wifiOpen[wifiCount] = (WiFi.encryptionType(i) == WIFI_AUTH_OPEN);
        wifiCount++;
      }
    }
  }
  WiFi.scanDelete();
  WiFi.disconnect(false, false);
  WiFi.mode(WIFI_OFF);
  wifiSelected = 0;
  currentScreen = forChannelMap ? SCR_CHANNEL_MAP : SCR_WIFI_LIST;
  if (forChannelMap) drawChannelMap(); else drawWiFiDetails();
}

void drawWiFiDetails() {
  char right[10];
  snprintf(right, sizeof(right), "%02u/%02u", (unsigned)(wifiCount ? wifiSelected + 1 : 0), (unsigned)wifiCount);
  startFrame("WIFI SCAN", right);
  if (!wifiCount) {
    centeredText("No networks found", 23);
    centeredText("Try scanning again", 35);
    footer("TAP RESCAN  HOLD BACK");
    present();
    return;
  }
  display.drawRoundRect(4, 13, 120, 15, 2, SSD1306_WHITE);
  display.setCursor(8, 17);
  String ssid = strlen(wifiNames[wifiSelected]) ? String(wifiNames[wifiSelected]) : String("<hidden network>");
  display.print(clipped(ssid, 18));
  display.setCursor(7, 32);
  display.print("RSSI "); display.print(wifiRssi[wifiSelected]); display.print(" dBm");
  display.setCursor(7, 42);
  display.print("CH "); display.print(wifiChannel[wifiSelected]);
  display.print("  "); display.print(wifiOpen[wifiSelected] ? "OPEN" : "LOCKED");
  footer("TAP NEXT  HOLD BACK");
  present();
}

void drawChannelMap() {
  char label[20];
  snprintf(label, sizeof(label), "CHANNEL MAP  AP:%u", (unsigned)wifiTotalFound);
  startFrame(label);
  uint8_t maxCount = 0;
  for (uint8_t ch = 1; ch <= 13; ch++) if (channelCounts[ch] > maxCount) maxCount = channelCounts[ch];
  if (!wifiTotalFound) {
    centeredText("No 2.4 GHz APs", 25);
    centeredText("found nearby", 36);
  } else {
    const int baseY = 43;
    display.drawLine(5, baseY, 123, baseY, SSD1306_WHITE);
    for (uint8_t ch = 1; ch <= 13; ch++) {
      int x = 7 + (ch - 1) * 9;
      int height = maxCount ? (int)((channelCounts[ch] * 25UL) / maxCount) : 0;
      if (channelCounts[ch] && height < 2) height = 2;
      if (height > 25) height = 25;
      if (height > 0) display.fillRect(x, baseY - height, 5, height, SSD1306_WHITE);
      char digit[3]; snprintf(digit, sizeof(digit), "%u", ch);
      display.setCursor(x - (ch >= 10 ? 1 : 0), 44);
      display.print(digit);
    }
    display.setCursor(5, 12);
    display.print("APs per channel");
  }
  footer("TAP RESCAN  HOLD BACK");
  present();
}

// ------------------------- BLE TOOLS ---------------------------------
void runBLEScan() {
  showMessage("BLE RADAR", "Scanning BLE...", "Radio on temporarily");
  turnWiFiOff();
  bleCount = 0;
  bleTotalFound = 0;

  BLEDevice::init("");
  BLEScan *scanner = BLEDevice::getScan();
  if (scanner != nullptr) {
    scanner->setActiveScan(false); // passive scan: do not request extra data
    scanner->setInterval(100);
    scanner->setWindow(80);
    BLEScanResults *results = scanner->start(4, false);
    if (results != nullptr) {
      int count = (int)results->getCount();
      bleTotalFound = (uint16_t)count;
      for (int i = 0; i < count && bleCount < MAX_BLE; i++) {
        BLEAdvertisedDevice dev = results->getDevice(i);
        String name = dev.haveName() ? dev.getName() : String("Unknown device");
        String address = dev.getAddress().toString().c_str();
        bleNames[bleCount] = clipped(name, 25);
        bleAddresses[bleCount] = address;
        bleRssi[bleCount] = dev.getRSSI();
        bleCount++;
      }
    }
    scanner->clearResults();
  }
  BLEDevice::deinit(true);
  bleSelected = 0;
  currentScreen = SCR_BLE_LIST;
  drawBLEDetails();
}

void drawBLEDetails() {
  char right[10];
  snprintf(right, sizeof(right), "%02u/%02u", (unsigned)(bleCount ? bleSelected + 1 : 0), (unsigned)bleCount);
  startFrame("BLE RADAR", right);
  if (!bleCount) {
    centeredText("No BLE devices", 23);
    centeredText("detected nearby", 35);
    footer("TAP RESCAN  HOLD BACK");
    present();
    return;
  }
  display.drawRoundRect(4, 13, 120, 15, 2, SSD1306_WHITE);
  display.setCursor(8, 17);
  display.print(clipped(bleNames[bleSelected], 18));
  display.setCursor(7, 32);
  display.print("RSSI "); display.print(bleRssi[bleSelected]); display.print(" dBm");
  display.setCursor(7, 42);
  display.print(clipped(bleAddresses[bleSelected], 19));
  footer("TAP NEXT  HOLD BACK");
  present();
}

// ------------------------- REACTION GAME -----------------------------
void drawReaction() {
  startFrame("REACTION TEST");
  switch (reactionState) {
    case REACT_READY:
      centeredText("READY?", 20, 2);
      centeredText("Tap to start", 40);
      break;
    case REACT_WAITING:
      centeredText("WAIT...", 24, 2);
      centeredText("Don't press yet", 42);
      break;
    case REACT_GO:
      display.fillRoundRect(25, 16, 78, 31, 5, SSD1306_WHITE);
      display.setTextColor(SSD1306_BLACK);
      centeredText("GO!", 23, 2);
      display.setTextColor(SSD1306_WHITE);
      break;
    case REACT_RESULT:
      centeredText("YOUR REACTION", 16);
      centeredText(String(reactionMs) + " ms", 28, 2);
      centeredText(reactionMs < 220 ? "Super fast!" : reactionMs < 350 ? "Nice result" : "Try again", 44);
      break;
    case REACT_FALSE_START:
      centeredText("FALSE START!", 24, 2);
      centeredText("Wait for GO", 43);
      break;
  }
  footer("TAP ACTION  HOLD BACK");
  present();
}

void startReaction() {
  reactionState = REACT_WAITING;
  reactionStartedAt = millis();
  reactionDelay = 1200 + (esp_random() % 3000);
  drawReaction();
}

void handleReactionTap() {
  if (reactionState == REACT_READY || reactionState == REACT_RESULT || reactionState == REACT_FALSE_START) {
    startReaction();
  } else if (reactionState == REACT_WAITING) {
    // Avoid a false start if the GO edge happened just before this button event.
    uint32_t elapsed = millis() - reactionStartedAt;
    if (elapsed >= reactionDelay) {
      reactionMs = elapsed - reactionDelay;
      reactionState = REACT_RESULT;
    } else {
      reactionState = REACT_FALSE_START;
    }
    drawReaction();
  } else if (reactionState == REACT_GO) {
    reactionMs = millis() - reactionStartedAt - reactionDelay;
    reactionState = REACT_RESULT;
    drawReaction();
  }
}

