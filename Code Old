void applySetting() {
  if (settingsIndex == 0) {
    invertMode = !invertMode;
    prefs.putBool("invert", invertMode);
    display.invertDisplay(invertMode);
  } else if (settingsIndex == 1) {
    rotateMode = !rotateMode;
    prefs.putBool("rotate", rotateMode);
    applyDisplaySettings();
  } else {
    counterValue = 0;
    counterDirty = true;
    saveCounter();
  }
  drawSettings();
}

